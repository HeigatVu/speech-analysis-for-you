# Hugging Face access token (read-only is enough)
# Get one at https://huggingface.co/settings/tokens
# Export HF_TOKEN in the say-transcribe process environment; .env files are not auto-loaded.
# Also accept the model gates first:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=hf_xxx
